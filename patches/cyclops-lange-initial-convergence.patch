diff --git a/tests/testthat/test-langeInitialConvergence.R b/tests/testthat/test-langeInitialConvergence.R
new file mode 100644
index 0000000..38b05d6
--- /dev/null
+++ b/tests/testthat/test-langeInitialConvergence.R
@@ -0,0 +1,85 @@
+# Ordinary public fits only: this test also runs without coordinate APIs.
+langeInitialFit <- function(y, x, initial, variance = 0.1,
+                            criterion = "lange", maxIterations = 200L) {
+    sx <- as(Matrix::Matrix(x, ncol = 1, sparse = TRUE), "dgCMatrix")
+    colnames(sx) <- "feature"
+    data <- createCyclopsData(y ~ 1, data = data.frame(y = y), sx = sx,
+                              modelType = "lr", floatingPoint = 64)
+    data$coefficientNames <- c("(Intercept)", "feature")
+    fitCyclopsModel(data,
+        createPrior("laplace", variance = variance, exclude = "(Intercept)",
+                    useCrossValidation = FALSE),
+        createControl(convergenceType = criterion, tolerance = 1e-12,
+                      maxIterations = maxIterations, noiseLevel = "silent",
+                      threads = 1, useKKTSwindle = FALSE),
+        startingCoefficients = initial)
+}
+
+langeInitialKkt <- function(y, x, beta, variance) {
+    eta <- beta[1L] + x * beta[2L]
+    gradient <- c(sum(plogis(eta) - y), sum(x * (plogis(eta) - y)))
+    lambda <- c(0, sqrt(2 / variance))
+    residual <- c(abs(gradient[1L]), if (beta[2L] == 0)
+        max(abs(gradient[2L]) - lambda[2L], 0) else
+        abs(gradient[2L] + lambda[2L] * sign(beta[2L])))
+    logLikelihood <- -sum(log1p(exp(-abs(eta))) +
+                         ifelse(y == 1, pmax(-eta, 0), pmax(eta, 0)))
+    list(gradient = gradient, logLikelihood = logLikelihood,
+         logPrior = log(lambda[2L] / 2) - lambda[2L] * abs(beta[2L]),
+         ratio = residual / (1e-8 + 1e-8 * pmax(1, abs(gradient), lambda)))
+}
+
+test_that("Lange accepts independently verified initial optima after one sweep", {
+    fixtures <- list(
+        list(y = c(0, 1, 0, 1), x = c(0, 0, 1, 1), initial = c(0, 0)),
+        list(y = c(0, 1, 1, 0, 1, 1), x = c(0, 0, 0, 1, 1, 1),
+             initial = c(log(2), 0)))
+    for (fixture in fixtures) {
+        before <- langeInitialKkt(fixture$y, fixture$x, fixture$initial, 0.1)
+        expect_true(all(before$ratio <= 1))
+        fit <- langeInitialFit(fixture$y, fixture$x, fixture$initial)
+        expect_identical(fit$return_flag, "SUCCESS")
+        expect_equal(fit$iterations, 1)
+        beta <- unname(coef(fit))
+        after <- langeInitialKkt(fixture$y, fixture$x, beta, 0.1)
+        expect_equal(beta, fixture$initial, tolerance = 1e-12)
+        expect_true(all(after$ratio <= 1))
+        expect_equal(-unname(gradient(fit)), after$gradient, tolerance = 1e-10)
+        expect_equal(fit$log_likelihood, after$logLikelihood, tolerance = 1e-12)
+        expect_equal(fit$log_prior, after$logPrior, tolerance = 1e-12)
+        expect_equal(unname(predict(fit)), plogis(beta[1L] + fixture$x * beta[2L]),
+                     tolerance = 1e-12)
+    }
+})
+
+test_that("nonzero updates, Laplace shrinkage and iteration limits remain active", {
+    y <- c(rep(1, 8), rep(0, 2), rep(1, 2), rep(0, 8))
+    x <- c(rep(1, 10), rep(0, 10))
+    fit <- langeInitialFit(y, x, c(0, 0), variance = 1)
+    weaker <- langeInitialFit(y, x, c(0, 0), variance = 10)
+    expect_identical(fit$return_flag, "SUCCESS")
+    expect_identical(weaker$return_flag, "SUCCESS")
+    expect_gt(abs(coef(fit)[2L]), 0)
+    expect_lt(abs(coef(fit)[2L]), abs(coef(weaker)[2L]))
+    expect_gt(fit$iterations, 1)
+    limited <- langeInitialFit(y, x, c(0, 0), variance = 1, maxIterations = 1L)
+    expect_identical(limited$return_flag, "MAX_ITERATIONS")
+    expect_error(coef(limited), "did not converge")
+    expect_equal(limited$iterations, 1)
+})
+
+test_that("the gradient recovery and other termination checks are preserved", {
+    y <- c(0, 1, 0, 1)
+    x <- c(0, 0, 1, 1)
+    expect_warning(recovered <- langeInitialFit(y, x, c(0, 0), criterion = "gradient"),
+                   "BLR convergence criterion failed")
+    expect_identical(recovered$return_flag, "SUCCESS")
+    expect_identical(langeInitialFit(y, x, c(0, 0), criterion = "onestep")$return_flag,
+                     "SUCCESS")
+    # This patch does not reclassify the other objective-based stopping type.
+    expect_identical(langeInitialFit(y, x, c(0, 0), criterion = "mittal")$return_flag,
+                     "POOR_BLR_STEP")
+    bad <- langeInitialFit(y, x, c(NaN, 0))
+    expect_identical(bad$return_flag, "ILLCONDITIONED")
+    expect_error(coef(bad), "did not converge")
+})
