+#' @rdname initializeCyclopsCoordinateDescent
+#' @export
+getCyclopsCoordinateStatistics <- function(object, covariate) {
+    index <- .checkCyclopsCoordinate(object, covariate)
+    .cyclopsCoordinateStatistics(object$cyclopsInterfacePtr, index - 1L)
+}
+
+#' @rdname initializeCyclopsCoordinateDescent
+#' @export
+updateCyclopsCoordinate <- function(object, covariate, gradient, curvature) {
+    index <- .checkCyclopsCoordinate(object, covariate)
+    if (!is.numeric(gradient) || length(gradient) != 1L || !is.finite(gradient) ||
+        !is.numeric(curvature) || length(curvature) != 1L || !is.finite(curvature)) {
+        stop("gradient and curvature must be finite numeric scalars")
+    }
+    .cyclopsUpdateCoordinate(object$cyclopsInterfacePtr, index - 1L,
+                             gradient, curvature)
+}
+
+#' @rdname initializeCyclopsCoordinateDescent
+#' @export
+checkCyclopsCoordinateConvergence <- function(object, logLikelihood = NULL) {
+    .checkCyclopsCoordinate(object)
+    if (is.null(logLikelihood)) {
+        logLikelihood <- .cyclopsGetLogLikelihood(object$cyclopsInterfacePtr)
+    }
+    if (!is.numeric(logLikelihood) || length(logLikelihood) != 1L ||
+        !is.finite(logLikelihood)) {
+        stop("logLikelihood must be a finite numeric scalar")
+    }
+    .cyclopsCheckCoordinateConvergence(object$cyclopsInterfacePtr, logLikelihood)
+}
+
+#' @rdname initializeCyclopsCoordinateDescent
+#' @export
+getCyclopsCoordinateFit <- function(object) {
+    .checkCyclopsCoordinate(object)
+    fit <- .cyclopsCoordinateDiagnostics(object$cyclopsInterfacePtr)
+    estimates <- .cyclopsLogModel(object$cyclopsInterfacePtr)
+    fit$interface <- estimates$interface
+    fit$estimation <- as.data.frame(estimates$estimation)
+    fit$cyclopsData <- object
+    fit$coefficientNames <- object$coefficientNames
+    fit$rowNames <- object$rowNames
+    fit$control <- object$coordinateControl
+    fit$call <- object$call
+    class(fit) <- "cyclopsFit"
+    fit
+}
+
+.checkCyclopsCoordinate <- function(object, covariate = NULL) {
+    if (!inherits(object, "cyclopsData") ||
+        is.null(object$coordinateInterface) ||
+        !identical(object$coordinateInterface, object$cyclopsInterfacePtr)) {
+        stop("Expected an initialized coordinate-descent object")
+    }
+    .checkData(object)
+    .checkInterface(object, testOnly = TRUE)
+    if (!is.null(covariate)) {
+        if (!is.character(covariate) || length(covariate) != 1L ||
+            is.na(covariate) || !covariate %in% object$coefficientNames) {
+            stop("covariate must name a feature in this coordinate state")
+        }
+        return(match(covariate, object$coefficientNames))
+    }
+    invisible(NULL)
+}
