+    # Only the intercept is dense. The existing constructor retains empty
+    # sparse columns and creates independent native data for each call.
+    intercept <- Matrix::Matrix(1, nrow = length(y), ncol = 1, sparse = FALSE,
+                                dimnames = list(names(y), "(Intercept)"))
