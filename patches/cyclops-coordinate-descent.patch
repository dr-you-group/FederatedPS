+    XPtr<bsccs::RcppCcdInterface> interface(inRcppCcdInterface);
+    auto& ccd = interface->getCcd();
+    ccd.checkCoordinateState();
+    interface->diagnoseModel(0.0, 0.0);
+    List result = clone(interface->getResult());
+    if (!ccd.coordinateDescentIsFinished()) {
+        result["return_flag"] = "IN_PROGRESS";
+    }
+    result["finished"] = ccd.coordinateDescentIsFinished();
+    result["nextCoordinate"] = ccd.getNextCoordinate() + 1;
+    result["convergence"] = ccd.getCoordinateConvergence();
+    return result;
+}
