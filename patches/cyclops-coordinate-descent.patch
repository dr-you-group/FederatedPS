+    }
+    featureNames <- colnames(sx)
+    if (is.null(featureNames) || anyNA(featureNames) ||
+        any(!nzchar(featureNames)) || anyDuplicated(featureNames) ||
+        "(Intercept)" %in% featureNames) {
+        stop("sx must have unique nonempty feature names without an intercept")
+    }
+    if (any(!is.finite(sx@x))) {
+        stop("sx contains non-finite values")
+    }
+    coefficientNames <- c("(Intercept)", featureNames)
+    if (!is.numeric(startingCoefficients) || !is.null(dim(startingCoefficients)) ||
+        length(startingCoefficients) != length(coefficientNames) ||
+        any(!is.finite(startingCoefficients)) ||
+        !identical(names(startingCoefficients), coefficientNames)) {
+        stop("startingCoefficients must be finite and named in intercept/feature order")
+    }
+    if (!inherits(prior, "cyclopsPrior") ||
+        !identical(prior$priorType, "laplace") ||
+        length(prior$variance) != 1L || !is.finite(prior$variance) ||
+        prior$variance <= 0 || !identical(prior$useCrossValidation, FALSE) ||
+        !is.null(prior$graph) || !is.null(prior$neighborhood) ||
+        !is.null(prior$setHook) || !is.null(prior$fitHook) ||
+        !identical(prior$forceIntercept, FALSE) ||
+        length(prior$exclude) != 1L ||
+        !identical(prior$exclude, "(Intercept)")) {
