diff --git a/tests/testthat/test-coordinateDescent.R b/tests/testthat/test-coordinateDescent.R
new file mode 100644
index 0000000000000000000000000000000000000000..88a0a379946977a6fd78f3f9d5519ac16399e759
--- /dev/null
+++ b/tests/testthat/test-coordinateDescent.R
@@ -0,0 +1,412 @@
+library(testthat)
+
+# These settings are synthetic test choices, not a study protocol. Tolerances
+# are fixed before executing either build: abs(error) <= atol + rtol * scale.
+coordinateTestSettings <- list(
+    seed = 1701L,
+    dimensions = list(basic = c(n = 80L, p = 8L, left = 40L),
+                      unequal = c(n = 73L, p = 12L, left = 9L),
+                      wide = c(n = 24L, p = 40L, left = 7L)),
+    density = 0.22,
+    variance = 1,
+    initial = 0,
+    control = list(convergenceType = "lange", tolerance = 1e-12,
+                   maxIterations = 5000L, initialBound = 2,
+                   algorithm = "ccd", threads = 1L, seed = 1701L,
+                   useKKTSwindle = FALSE, noiseLevel = "silent"),
+    coordinateTolerance = c(absolute = 1e-10, relative = 1e-10),
+    finalTolerance = c(absolute = 1e-7, relative = 1e-7)
+)
+
+coordinateTestFixtures <- function() {
+    set.seed(coordinateTestSettings$seed)
+    lapply(names(coordinateTestSettings$dimensions), function(name) {
+        dims <- coordinateTestSettings$dimensions[[name]]
+        n <- dims[["n"]]
+        p <- dims[["p"]]
+        x <- Matrix::rsparsematrix(n, p, coordinateTestSettings$density,
+            rand.x = function(k) sample(c(-1, 0.5, 1, 2), k, replace = TRUE))
+        for (j in seq_len(p)) {
+            x[(j - 1L) %% n + 1L, j] <- 1
+        }
+        if (name != "basic") {
+            x[seq_len(dims[["left"]]), p] <- 0
+            x[dims[["left"]] + 1L, p] <- 1
+        }
+        if (name == "wide") {
+            x[, p - 1L] <- x[, p - 2L]
+            x[, p - 3L] <- x[, 1L] + 0.5 * x[, 2L]
+        }
+        x <- Matrix::drop0(x)
+        dimnames(x) <- list(paste0("r", seq_len(n)), paste0("x", seq_len(p)))
+        eta <- -0.3 + 1.8 * x[, 1L] - 1.1 * x[, 2L] + 0.8 * x[, 3L]
+        y <- setNames(as.numeric(rbinom(n, 1L, plogis(as.numeric(eta)))), rownames(x))
+        list(name = name, x = x, y = y, left = dims[["left"]],
+             initial = setNames(rep(coordinateTestSettings$initial, p + 1L),
+                                c("(Intercept)", colnames(x))))
+    })
+}
+
+coordinateTestControl <- function() do.call(createControl, coordinateTestSettings$control)
+coordinateTestPrior <- function() {
+    createPrior("laplace", variance = coordinateTestSettings$variance,
+                exclude = "(Intercept)", useCrossValidation = FALSE)
+}
+
+# Only pre-existing public Cyclops calls are used for the reference build.
+coordinateTestNormalFit <- function(fixture) {
+    started <- proc.time()[["elapsed"]]
+    y <- fixture$y
+    data <- createCyclopsData(y ~ 1, sx = fixture$x, modelType = "lr",
+                              floatingPoint = 64)
+    data$coefficientNames <- names(fixture$initial)
+    warnings <- character()
+    fit <- withCallingHandlers(
+        fitCyclopsModel(data, prior = coordinateTestPrior(),
+                        control = coordinateTestControl(),
+                        startingCoefficients = unname(fixture$initial)),
+        warning = function(w) {
+            warnings <<- c(warnings, conditionMessage(w))
+        })
+    ps <- unname(predict(fit))
+    beta <- unname(coef(fit, ignoreConvergence = TRUE))
+    gradient <- -unname(Cyclops::gradient(fit))
+    lambda <- sqrt(2 / coordinateTestSettings$variance)
+    residual <- abs(gradient)
+    nonzero <- beta[-1L] != 0
+    residual[-1L] <- ifelse(nonzero,
+        abs(gradient[-1L] + lambda * sign(beta[-1L])),
+        pmax(abs(gradient[-1L]) - lambda, 0))
+    list(beta = beta, eta = qlogis(ps), ps = ps,
+         objective = -(fit$log_likelihood + fit$log_prior),
+         logLikelihood = fit$log_likelihood, logPrior = fit$log_prior,
+         status = fit$return_flag, iterations = fit$iterations,
+         kktResidual = max(residual), warnings = warnings,
+         elapsed = proc.time()[["elapsed"]] - started)
+}
+
+coordinateFixtures <- coordinateTestFixtures()
+coordinateZeroFixture <- coordinateFixtures[[1L]]
+coordinateZeroFixture$x <- coordinateZeroFixture$x[, 1L, drop = FALSE]
+coordinateZeroFixture$x@x[] <- 0
+coordinateZeroFixture$initial <- coordinateZeroFixture$initial[1:2]
+referenceOutput <- Sys.getenv("CYCLOPS_CCD_REFERENCE_OUTPUT")
+if (nzchar(referenceOutput)) {
+    reference <- list(settings = coordinateTestSettings,
+                      fixtures = coordinateFixtures,
+                      results = lapply(coordinateFixtures, coordinateTestNormalFit),
+                      zeroColumn = coordinateTestNormalFit(coordinateZeroFixture),
+                      library = find.package("Cyclops"))
+    saveRDS(reference, referenceOutput)
+    cat("REFERENCE_LIBRARY", reference$library, "\n")
+    for (i in seq_along(reference$results)) {
+        result <- reference$results[[i]]
+        cat("REFERENCE", coordinateFixtures[[i]]$name, result$status,
+            "iterations", result$iterations, "KKT", result$kktResidual,
+            "warnings", length(result$warnings), "elapsed", result$elapsed, "\n")
+    }
+    cat("REFERENCE_ZERO_COLUMN", reference$zeroColumn$status,
+        "coefficient", reference$zeroColumn$beta[2L],
+        "warnings", length(reference$zeroColumn$warnings), "\n")
+} else {
+    coordinateErrors <- new.env(parent = emptyenv())
+    coordinateCompare <- function(actual, expected, item, final = FALSE) {
+        actual <- as.numeric(actual)
+        expected <- as.numeric(expected)
+        if (length(actual) != length(expected) ||
+            any(!is.finite(actual)) || any(!is.finite(expected))) {
+            stop(item, ": non-finite values or unequal lengths")
+        }
+        tol <- if (final) coordinateTestSettings$finalTolerance else
+            coordinateTestSettings$coordinateTolerance
+        error <- abs(actual - expected)
+        scale <- pmax(abs(actual), abs(expected))
+        relative <- ifelse(scale == 0, 0, error / scale)
+        budget <- tol[["absolute"]] + tol[["relative"]] * scale
+        values <- c(maxAbsolute = max(error), maxRelative = max(relative),
+                    maxBudgetRatio = max(error / budget))
+        previous <- coordinateErrors[[item]]
+        coordinateErrors[[item]] <- if (is.null(previous)) values else pmax(previous, values)
+        if (any(error > budget)) {
+            stop(item, ": maximum absolute error ", max(error),
+                 "; maximum tolerance-budget ratio ", max(error / budget))
+        }
+        invisible(TRUE)
+    }
+
+    coordinateInitialize <- function(fixture, rows = seq_along(fixture$y)) {
+        initializeCyclopsCoordinateDescent(fixture$y[rows],
+            fixture$x[rows, , drop = FALSE], prior = coordinateTestPrior(),
+            control = coordinateTestControl(), startingCoefficients = fixture$initial)
+    }
+
+    test_that("pooled and two local states follow the same existing CCD calculation", {
+        for (fixture in coordinateFixtures) {
+            started <- proc.time()[["elapsed"]]
+            referenceB <- coordinateTestNormalFit(fixture)
+            expect_identical(referenceB$status, "SUCCESS")
+            expect_length(referenceB$warnings, 0L)
+            pooled <- coordinateInitialize(fixture)
+            rows <- list(seq_len(fixture$left),
+                         seq.int(fixture$left + 1L, length(fixture$y)))
+            sites <- lapply(rows, function(index) coordinateInitialize(fixture, index))
+            initialFit <- getCyclopsCoordinateFit(pooled)
+            expect_identical(initialFit$return_flag, "IN_PROGRESS")
+            expect_equal(initialFit$iterations, 0)
+            coordinateCompare(coef(initialFit, ignoreConvergence = TRUE),
+                              fixture$initial, "initial-beta")
+            coordinateCompare(predict(initialFit), rep(0.5, length(fixture$y)), "initial-PS")
+            expect_error(coef(initialFit), "did not converge")
+            expect_error(getCyclopsCoordinateStatistics(pooled, "(Intercept)"),
+                         "Unexpected coordinate")
+
+            localFits <- lapply(sites, getCyclopsCoordinateFit)
+            initialLikelihood <- sum(vapply(localFits, function(f) f$log_likelihood, 0.0))
+            expect_false(checkCyclopsCoordinateConvergence(pooled))
+            for (site in sites) {
+                expect_false(checkCyclopsCoordinateConvergence(site, initialLikelihood))
+            }
+            done <- FALSE
+            firstSweep <- NULL
+            while (!done) {
+                for (j in seq_along(fixture$initial)) {
+                    name <- names(fixture$initial)[j]
+                    before <- getCyclopsCoordinateFit(pooled)
+                    beforePs <- unname(predict(before))
+                    pooledStatistics <- getCyclopsCoordinateStatistics(pooled, name)
+                    repeated <- getCyclopsCoordinateStatistics(pooled, name)
+                    coordinateCompare(repeated, pooledStatistics, "read-only-statistics")
+                    coordinateCompare(predict(getCyclopsCoordinateFit(pooled)),
+                                      beforePs, "read-only-predictor")
+                    column <- if (j == 1L) rep(1, length(fixture$y)) else
+                        as.numeric(fixture$x[, j - 1L])
+                    coordinateCompare(pooledStatistics[c("gradient", "curvature")],
+                        c(sum(column * (beforePs - fixture$y)),
+                          sum(column^2 * beforePs * (1 - beforePs))),
+                        "analytic-gradient-curvature")
+
+                    # Deliberately query the second state before the first.
+                    secondBefore <- unname(predict(getCyclopsCoordinateFit(sites[[2L]])))
+                    statistics2 <- getCyclopsCoordinateStatistics(sites[[2L]], name)
+                    statistics1 <- getCyclopsCoordinateStatistics(sites[[1L]], name)
+                    if (fixture$name != "basic" && j == length(fixture$initial)) {
+                        expect_equal(unname(statistics1[1:2]), c(0, 0))
+                    }
+                    coordinateCompare(predict(getCyclopsCoordinateFit(sites[[2L]])),
+                                      secondBefore, "site-isolation")
+                    globalStatistics <- statistics1[1:2] + statistics2[1:2]
+                    coordinateCompare(globalStatistics, pooledStatistics[1:2],
+                                      "summed-gradient-curvature")
+                    coordinateCompare(statistics1[3:4], pooledStatistics[3:4],
+                                      "pre-update-coefficient-bound")
+                    coordinateCompare(statistics2[3:4], pooledStatistics[3:4],
+                                      "pre-update-coefficient-bound")
+                    pooledUpdate <- updateCyclopsCoordinate(pooled, name,
+                        pooledStatistics[["gradient"]], pooledStatistics[["curvature"]])
+                    update1 <- updateCyclopsCoordinate(sites[[1L]], name,
+                        globalStatistics[["gradient"]], globalStatistics[["curvature"]])
+                    coordinateCompare(predict(getCyclopsCoordinateFit(sites[[2L]])),
+                                      secondBefore, "site-isolation")
+                    update2 <- updateCyclopsCoordinate(sites[[2L]], name,
+                        globalStatistics[["gradient"]], globalStatistics[["curvature"]])
+                    for (update in list(update1, update2)) {
+                        coordinateCompare(update[["increment"]], pooledUpdate[["increment"]],
+                                          "coordinate-increment")
+                        coordinateCompare(update[["bound"]], pooledUpdate[["bound"]],
+                                          "coordinate-bound")
+                    }
+                    after <- getCyclopsCoordinateFit(pooled)
+                    localFits <- lapply(sites, getCyclopsCoordinateFit)
+                    beta <- coef(after, ignoreConvergence = TRUE)
+                    for (fit in localFits) {
+                        coordinateCompare(coef(fit, ignoreConvergence = TRUE), beta,
+                                          "coordinate-beta")
+                    }
+                    ps <- unname(predict(after))
+                    sitePs <- unlist(lapply(localFits, function(f) unname(predict(f))))
+                    coordinateCompare(sitePs, ps, "coordinate-raw-PS")
+                    eta <- beta[1L] + as.numeric(fixture$x %*% beta[-1L])
+                    coordinateCompare(qlogis(ps), eta, "pooled-predictor-cache")
+                    coordinateCompare(qlogis(sitePs), eta, "site-predictor-cache")
+                }
+                pooledFit <- getCyclopsCoordinateFit(pooled)
+                localFits <- lapply(sites, getCyclopsCoordinateFit)
+                likelihood <- sum(vapply(localFits, function(f) f$log_likelihood, 0.0))
+                prior <- localFits[[1L]]$log_prior
+                coordinateCompare(likelihood + prior,
+                    pooledFit$log_likelihood + pooledFit$log_prior, "sweep-objective")
+                beta <- coef(pooledFit, ignoreConvergence = TRUE)
+                eta <- beta[1L] + as.numeric(fixture$x %*% beta[-1L])
+                lambda <- sqrt(2 / coordinateTestSettings$variance)
+                # Independent objective oracle, including Cyclops' prior constant.
+                logPosterior <- sum(fixture$y * eta -
+                    pmax(eta, 0) - log1p(exp(-abs(eta)))) +
+                    ncol(fixture$x) * log(lambda / 2) - lambda * sum(abs(beta[-1L]))
+                coordinateCompare(likelihood + prior, logPosterior, "analytic-objective")
+                if (is.null(firstSweep)) firstSweep <- -(likelihood + prior)
+                if (pooledFit$iterations == 1L) {
+                    coordinateCompare(likelihood + prior,
+                        pooledFit$log_likelihood + pooledFit$log_prior, "one-sweep-objective")
+                    coordinateCompare(unlist(lapply(localFits, function(f) unname(predict(f)))),
+                                      predict(pooledFit), "one-sweep-raw-PS")
+                    coordinateCompare(qlogis(unlist(lapply(localFits, function(f) unname(predict(f))))),
+                                      eta, "one-sweep-predictor")
+                }
+                done <- checkCyclopsCoordinateConvergence(pooled)
+                for (site in sites) {
+                    expect_identical(checkCyclopsCoordinateConvergence(site, likelihood), done)
+                }
+            }
+            final <- getCyclopsCoordinateFit(pooled)
+            finalSites <- lapply(sites, getCyclopsCoordinateFit)
+            expect_identical(final$return_flag, "SUCCESS")
+            expect_true(all(vapply(finalSites, function(f) f$return_flag == "SUCCESS", TRUE)))
+            expect_equal(final$iterations, referenceB$iterations)
+            coordinateCompare(-(final$log_likelihood + final$log_prior),
+                              referenceB$objective, "B-C-final-objective", final = TRUE)
+            coordinateCompare(predict(final), referenceB$ps, "B-C-final-raw-PS", final = TRUE)
+            coordinateCompare(qlogis(predict(final)), referenceB$eta,
+                              "B-C-final-predictor", final = TRUE)
+            if (fixture$name != "wide") {
+                coordinateCompare(coef(final), referenceB$beta, "B-C-final-beta", final = TRUE)
+            }
+            expect_true(any(coef(final)[-1L] != 0))
+            if (fixture$name == "basic") expect_true(any(coef(final)[-1L] == 0))
+            expect_error(updateCyclopsCoordinate(pooled, "(Intercept)", 0, 1),
+                         "Unexpected coordinate")
+            globalGradient <- -Reduce("+", lapply(finalSites, Cyclops::gradient))
+            finalBeta <- coef(final)
+            kkt <- c(abs(globalGradient[1L]), ifelse(finalBeta[-1L] == 0,
+                pmax(abs(globalGradient[-1L]) - lambda, 0),
+                abs(globalGradient[-1L] + lambda * sign(finalBeta[-1L]))))
+
+            referenceInput <- Sys.getenv("CYCLOPS_CCD_REFERENCE_INPUT")
+            if (nzchar(referenceInput)) {
+                referenceA <- readRDS(referenceInput)
+                expect_identical(referenceA$settings, coordinateTestSettings)
+                k <- match(fixture$name, vapply(referenceA$fixtures, function(x) x$name, ""))
+                expect_identical(referenceA$fixtures[[k]], fixture)
+                a <- referenceA$results[[k]]
+                expect_identical(a$status, "SUCCESS")
+                expect_length(a$warnings, 0L)
+                expect_equal(a$iterations, referenceB$iterations)
+                for (field in c("beta", "eta", "ps", "objective")) {
+                    coordinateCompare(referenceB[[field]], a[[field]],
+                                      paste0("A-B-", field), final = TRUE)
+                }
+                dPs <- unlist(lapply(finalSites, function(f) unname(predict(f))))
+                dObjective <- -(sum(vapply(finalSites, function(f) f$log_likelihood, 0.0)) +
+                                  finalSites[[1L]]$log_prior)
+                coordinateCompare(dPs, a$ps, "A-D-final-raw-PS", final = TRUE)
+                coordinateCompare(qlogis(dPs), a$eta, "A-D-final-predictor", final = TRUE)
+                coordinateCompare(dObjective, a$objective, "A-D-final-objective", final = TRUE)
+            }
+            cat("\nCCD_FIXTURE", fixture$name, "iterations", final$iterations,
+                "first_sweep_objective", format(firstSweep, digits = 16),
+                "normal_fit_KKT_diagnostic", format(referenceB$kktResidual, digits = 6),
+                "two_site_KKT_diagnostic", format(max(kkt), digits = 6),
+                "status", final$return_flag,
+                "elapsed", proc.time()[["elapsed"]] - started, "\n")
+        }
+    })
+
+    test_that("coordinate input and state errors are explicit", {
+        fixture <- coordinateFixtures[[1L]]
+        init <- function(y = fixture$y, x = fixture$x, initial = fixture$initial,
+                         prior = coordinateTestPrior(), control = coordinateTestControl()) {
+            initializeCyclopsCoordinateDescent(y, x, prior, control, initial)
+        }
+        expect_error(init(y = fixture$y[-1L]), "aligned")
+        badY <- fixture$y
+        names(badY) <- rev(names(badY))
+        expect_error(init(y = badY), "match exactly")
+        badY <- fixture$y
+        badY[1L] <- 2
+        expect_error(init(y = badY), "binary")
+        badY[1L] <- NA_real_
+        expect_error(init(y = badY), "binary")
+        badX <- fixture$x
+        badX@x[1L] <- Inf
+        expect_error(init(x = badX), "non-finite")
+        badX@x[1L] <- NaN
+        expect_error(init(x = badX), "non-finite")
+        badX <- fixture$x
+        colnames(badX)[2L] <- colnames(badX)[1L]
+        expect_error(init(x = badX), "unique nonempty feature")
+        expect_error(init(initial = rev(fixture$initial)), "feature order")
+        badInitial <- fixture$initial
+        badInitial[1L] <- Inf
+        expect_error(init(initial = badInitial), "finite")
+        expect_error(init(prior = createPrior("normal", exclude = 0)), "Laplace")
+        expect_error(init(prior = createPrior("laplace", exclude = 0,
+                                              useCrossValidation = TRUE)), "fixed")
+        expect_error(init(control = createControl(convergenceType = "gradient")), "Lange")
+        expect_error(init(control = createControl(convergenceType = "lange",
+                                                  useKKTSwindle = TRUE)), "screening")
+        object <- init()
+        expect_error(getCyclopsCoordinateStatistics(object, "unknown"), "name a feature")
+        expect_error(checkCyclopsCoordinateConvergence(object, Inf), "finite")
+        expect_false(checkCyclopsCoordinateConvergence(object))
+        expect_error(getCyclopsCoordinateStatistics(object, "x1"), "Unexpected coordinate")
+        expect_error(updateCyclopsCoordinate(object, "(Intercept)", NaN, 1), "finite")
+        expect_error(updateCyclopsCoordinate(object, "(Intercept)", 0, -1), "positive")
+        expect_error(updateCyclopsCoordinate(object, "(Intercept)", 0, 0), "zero columns")
+        expect_error(checkCyclopsCoordinateConvergence(object), "complete sweep")
+
+        # Retain a globally zero column. Local statistics are zero, but using
+        # them as global curvature is rejected without numerical correction.
+        zeroX <- fixture$x[, 1L, drop = FALSE]
+        zeroX@x[] <- 0
+        zeroInitial <- fixture$initial[1:2]
+        zero <- init(x = zeroX, initial = zeroInitial)
+        expect_false(checkCyclopsCoordinateConvergence(zero))
+        gh <- getCyclopsCoordinateStatistics(zero, "(Intercept)")
+        updateCyclopsCoordinate(zero, "(Intercept)", gh[["gradient"]], gh[["curvature"]])
+        zeroGh <- getCyclopsCoordinateStatistics(zero, "x1")
+        expect_equal(unname(zeroGh[1:2]), c(0, 0))
+        expect_error(updateCyclopsCoordinate(zero, "x1", 0, 0), "global zero columns")
+        normalZero <- coordinateTestNormalFit(coordinateZeroFixture)
+        expect_identical(normalZero$status, "SUCCESS")
+        expect_equal(normalZero$beta[2L], 0)
+        referenceInput <- Sys.getenv("CYCLOPS_CCD_REFERENCE_INPUT")
+        if (nzchar(referenceInput)) {
+            referenceZero <- readRDS(referenceInput)$zeroColumn
+            expect_identical(normalZero$status, referenceZero$status)
+            coordinateCompare(normalZero$ps, referenceZero$ps, "A-B-zero-column-PS", final = TRUE)
+        }
+
+        shortControl <- coordinateTestControl()
+        shortControl$maxIterations <- 1L
+        limited <- init(control = shortControl)
+        checkCyclopsCoordinateConvergence(limited)
+        for (name in names(fixture$initial)) {
+            gh <- getCyclopsCoordinateStatistics(limited, name)
+            updateCyclopsCoordinate(limited, name, gh[["gradient"]], gh[["curvature"]])
+        }
+        expect_true(checkCyclopsCoordinateConvergence(limited))
+        expect_identical(getCyclopsCoordinateFit(limited)$return_flag, "MAX_ITERATIONS")
+        expect_error(coef(getCyclopsCoordinateFit(limited)), "did not converge")
+
+        # An ordinary fit is allowed, but stepwise use of its state must stop.
+        reused <- init()
+        fitCyclopsModel(reused, prior = coordinateTestPrior(),
+                        control = coordinateTestControl(),
+                        startingCoefficients = unname(fixture$initial))
+        expect_error(getCyclopsCoordinateFit(reused), "changed outside")
+    })
+
+    test_that("the independent reference comparison was requested when configured", {
+        input <- Sys.getenv("CYCLOPS_CCD_REFERENCE_INPUT")
+        if (!nzchar(input)) {
+            skip("Set CYCLOPS_CCD_REFERENCE_INPUT to compare with the separately built fixed commit")
+        }
+        expect_true(file.exists(input))
+        expect_false(identical(readRDS(input)$library, find.package("Cyclops")))
+    })
+
+    if (length(ls(coordinateErrors))) {
+        cat("\nCCD_MAXIMUM_ERRORS\n")
+        errors <- do.call(rbind, as.list(coordinateErrors))
+        print(errors[order(rownames(errors)), , drop = FALSE], digits = 8)
+    }
+}
