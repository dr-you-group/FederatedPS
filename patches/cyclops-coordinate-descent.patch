+    object$coordinateControl <- .setControl(object$cyclopsInterfacePtr, control)
+    .cyclopsSetBeta(object$cyclopsInterfacePtr, unname(startingCoefficients))
+    .cyclopsSetStartingBeta(object$cyclopsInterfacePtr, unname(startingCoefficients))
