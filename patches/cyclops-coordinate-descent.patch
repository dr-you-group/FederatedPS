+void CyclicCoordinateDescent::initializeCoordinateDescent(const ModeFindingArguments& arguments) {
+    if (hXI.getModelType() != ModelType::LOGISTIC || hXI.getFloatingPointSize() != 64 ||
+        usingGPU || usingCUDA || useCrossValidation || !hWeights.empty() ||
+        !cWeights.empty() || hXI.getHasOffsetCovariate() || !jointPrior ||
+        arguments.algorithmType != AlgorithmType::CCD || arguments.useKktSwindle ||
+        arguments.convergenceType != LANGE || !std::isfinite(arguments.tolerance) ||
+        arguments.tolerance <= 0 || arguments.maxIterations < 1 ||
+        !std::isfinite(arguments.initialBound) || arguments.initialBound <= 0) {
+        error->throwError(std::ostringstream("Coordinate descent requires unweighted float64 CPU logistic CCD and Lange convergence."));
+    }
+    const auto y = hXI.copyYVector();
+    if (y.empty() || J < 2 || !std::all_of(y.begin(), y.end(),
+            [](double value) { return value == 0.0 || value == 1.0; })) {
+        error->throwError(std::ostringstream("Coordinate descent requires binary outcomes and an intercept plus covariates."));
+    }
+    for (int j = 0; j < J; ++j) {
+        if (!std::isfinite(hBeta[j]) || fixBeta[j] ||
+            jointPrior->getPriorType(j) != (j == 0 ? priors::NONE : priors::LAPLACE)) {
+            error->throwError(std::ostringstream("Coordinate descent requires finite coefficients and independent Laplace priors excluding the intercept."));
+        }
+    }
+    initialBound = arguments.initialBound;
+    checkAllLazyFlags();
+    hXI.clean();
+    resetBounds();
+    if (!std::isfinite(getLogLikelihood()) || !std::isfinite(getLogPrior())) {
+        error->throwError(std::ostringstream("Non-finite initial coordinate objective."));
+    }
+    coordinateInitialized = true;
+    coordinateFinished = false;
+    coordinateNeedsCheck = true;
+    coordinateIndex = 0;
+    coordinateLastObjective = 0.0;
+    coordinateConvergence = std::numeric_limits<double>::quiet_NaN();
+    lastIterationCount = 0;
+    lastReturnFlag = FAIL;
+}
+
+void CyclicCoordinateDescent::checkCoordinateState() const {
+    if (!coordinateInitialized || !xBetaKnown || !sufficientStatisticsKnown ||
+        !validWeights || hXI.getTouchedX() || hXI.getTouchedY()) {
+        error->throwError(std::ostringstream("Coordinate state is not initialized or was changed outside the coordinate API."));
+    }
+}
+
+void CyclicCoordinateDescent::checkCoordinateIndex(int index) const {
+    checkCoordinateState();
+    if (coordinateFinished || coordinateNeedsCheck || index < 0 || index >= J ||
+        index != coordinateIndex) {
+        error->throwError(std::ostringstream("Unexpected coordinate: check convergence before starting a sweep and update coordinates in order."));
+    }
+}
+
+std::vector<double> CyclicCoordinateDescent::getCoordinateStatistics(int index) {
+    checkCoordinateIndex(index);
+    computeNumeratorForGradient(index);
+    priors::GradientHessian gh;
+    computeGradientAndHessian(index, &gh.first, &gh.second);
+    if (!std::isfinite(gh.first) || !std::isfinite(gh.second) || gh.second < 0.0) {
+        error->throwError(std::ostringstream("Non-finite coordinate statistics or negative local curvature."));
+    }
+    return {gh.first, gh.second, hBeta[index], hDelta[index]};
+}
+
+std::vector<double> CyclicCoordinateDescent::updateCoordinate(int index,
+                                                            double gradient,
+                                                            double curvature) {
+    checkCoordinateIndex(index);
+    // A missing local column may have h=0. Only the aggregated curvature must
+    // be positive; no ridge or denominator correction is added.
+    if (!std::isfinite(gradient) || !std::isfinite(curvature) || curvature <= 0.0) {
+        error->throwError(std::ostringstream("Global coordinate curvature must be positive and statistics must be finite (global zero columns are unsupported)."));
+    }
+    double delta = coordinateIncrement(index, {gradient, curvature});
+    if (!std::isfinite(delta)) {
+        error->throwError(std::ostringstream("Non-finite coordinate increment."));
+    }
+    delta = applyCoordinateIncrement(index, delta);
+    fisherInformationKnown = false;
+    varianceKnown = false;
+    ++coordinateIndex;
+    if (coordinateIndex == J) {
+        coordinateIndex = 0;
+        ++lastIterationCount;
+        coordinateNeedsCheck = true;
+    }
+    return {delta, hBeta[index], hDelta[index]};
+}
+
+bool CyclicCoordinateDescent::checkCoordinateConvergence(double logLikelihood,
+                                                         const ModeFindingArguments& arguments) {
+    checkCoordinateState();
+    if (coordinateFinished || !coordinateNeedsCheck || coordinateIndex != 0) {
+        error->throwError(std::ostringstream("Convergence can only be checked initially or once after each complete sweep."));
+    }
+    // The caller sums site likelihoods. The common prior is included once.
+    const double objective = logLikelihood + getLogPrior();
+    if (!std::isfinite(logLikelihood) || !std::isfinite(objective)) {
+        error->throwError(std::ostringstream("Non-finite global coordinate objective."));
+    }
+    if (lastIterationCount == 0) {
+        coordinateLastObjective = objective;
+    } else {
+        coordinateConvergence = computeConvergenceCriterion(objective, coordinateLastObjective);
+        coordinateFinished = performCheckConvergence(LANGE, arguments.tolerance,
+            arguments.maxIterations, lastIterationCount, &coordinateLastObjective, objective);
+    }
+    coordinateNeedsCheck = false;
+    return coordinateFinished;
 }
 
