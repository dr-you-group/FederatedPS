+    .cyclopsSetHasIntercept(object, TRUE)
+    .checkInterface(object)
+    interceptId <- getCovariateIds(object)[1]
+    .cyclopsSetPrior(object$cyclopsInterfacePtr, "laplace", prior$variance,
+                     interceptId, NULL, NULL)
